{
  "name": "OpenRadioss-language-package",
  "displayName": "OpenRadioss-language package",
  "description": "Syntax highlighting and language support for OpenRadioss CAE input files (.rad)",
  "version": "1.1.0",
  "publisher": "Nakashin0212",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1E293B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pjkachina/openradioss-language-support.git"
  },
  "bugs": {
    "url": "https://github.com/pjkachina/openradioss-language-support/issues"
  },
  "homepage": "https://github.com/pjkachina/openradioss-language-support#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "openradioss",
    "radioss",
    "rad",
    "cae",
    "fea",
    "fem",
    "syntax",
    "highlighting",
    "simulation",
    "engineering",
    "altair"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "openradioss-panel",
          "title": "OpenRadioss",
          "icon": "assets/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "openradioss-panel": [
        {
          "id": "openradiossOutline",
          "name": "Deck Structure",
          "icon": "assets/activitybar-icon.svg",
          "contextualTitle": "OpenRadioss"
        }
      ]
    },
    "commands": [
      {
        "command": "openradioss.refreshOutline",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "OpenRadioss"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "openradioss.refreshOutline",
          "when": "view == openradiossOutline",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "rad",
        "aliases": [
          "OpenRadioss",
          "rad"
        ],
        "extensions": [
          ".rad",
          ".radians"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rad",
        "scopeName": "source.rad",
        "path": "./syntaxes/openradioss.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "typescript": "^5.3.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@vscode/extension-telemetry": "^0.9.0"
  }
}
