#---1----|----2----|----3----|----4----|----5----|----6----|----7----|----8----|
# DeckLens sample deck v2 — revised structural model
# Changes vs v1:
#   - Thickness 1.2 → 1.6 mm (+33%)     bending stiffness +138%
#   - E 210000 → 206000 MPa (-1.9%)     Young's modulus adjusted
#   - BCS: added rotational constraints
#   - Force magnitude 1000 → 2000 N (+100%)
# Units: Mg, mm, s  → force [N], stress [MPa]
/BEGIN
/UNIT/1
SI_mm
Mg  mm  s
#
# Material: elastic steel (E slightly reduced — updated data sheet)
/MAT/ELAST/1
STEEL_E210
  7.85E-9
  206000.0  0.3
#
# Shell property: 1.6mm outer panel (thickness increased for stiffness target)
/PROP/SHELL/1
OUTER_PANEL
  0  0  0  0
  1.6  0.0  0.0  0  0  0  0  0
#
# Part definition (unchanged)
/PART/1
PANEL_PART
  1  1  0  0  0
#
# Boundary condition: fully fixed support (translational + rotational)
/BCS/1
FIXED_SUPPORT
  0  0
  1  1  1  1  1  1
#
# Applied force in Z direction, Fscale=2000 N (doubled)
/CLOAD/1
APPLIED_FORCE
  1  Z  1.0  2000.0  0.0  1.0E+30
#
# Nodes (unchanged)
/NODE
         1       0.000000       0.000000       0.000000
         2     100.000000       0.000000       0.000000
         3     100.000000     100.000000       0.000000
         4       0.000000     100.000000       0.000000
         5     200.000000       0.000000       0.000000
         6     200.000000     100.000000       0.000000
#
# Shell elements (unchanged)
/SHELL/1
         1         1         1         2         3         4
         2         1         2         5         6         3
#
/END
